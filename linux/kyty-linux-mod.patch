@@ -0,0 +1,108 @@
+#pragma once
+#include <array>
+#include <cmath>
+#include <algorithm>
+#include <cstdint>
+#include <cstddef>
+
+namespace Surround {
+// Guest layout verified against build 3e6ee3e's disassembly. No ownership is taken.
+struct Port {
+ bool used; unsigned char pad[7]; uint64_t handle,context;
+ uint16_t type; uint16_t pad2; uint32_t format,rate,frames;
+ int audioFormat,audioHandle; const float* pcm; float gain; uint32_t ambisonics;
+};
+static_assert(sizeof(Port)==64 && offsetof(Port,pcm)==48 && offsetof(Port,ambisonics)==60);
+
+constexpr int Channels=6, Coefficients=36;
+// ACN/SN3D real spherical harmonics, without the Condon-Shortley phase.
+// Positive azimuth is left. Positions are FL FR C LFE SL SR.
+inline std::array<double,36> Basis(double azimuth,double elevation=0) {
+ std::array<double,36> y{};
+ for(int n=0;n<=5;n++) for(int m=0;m<=n;m++) {
+  double p=1,x=std::sin(elevation),root=std::sqrt(std::max(0.0,1-x*x));
+  for(int k=1;k<=m;k++) p*=(2*k-1)*root;
+  if(n>m) {
+   double prev=p,current=(2*m+1)*x*p;
+   for(int l=m+2;l<=n;l++) {double next=((2*l-1)*x*current-(l+m-1)*prev)/(l-m);prev=current;current=next;}
+   p=current;
+  }
+  double ratio=1;for(int k=n-m+1;k<=n+m;k++)ratio/=k;
+  double norm=std::sqrt((m==0?1.0:2.0)*ratio);
+  y[n*(n+1)+m]=norm*p*std::cos(m*azimuth);
+  if(m)y[n*(n+1)-m]=norm*p*std::sin(m*azimuth);
+ }
+ return y;
+}
+
+struct Decoder {
+ double matrix[5][36]{};
+ Decoder() {
+  // All-round decoding: integrate a dense virtual sphere, panning each virtual
+  // direction onto its two neighbouring horizontal speakers with equal-power
+  // VBAP. This covers the large rear gap of 5.1 without sampling nulls there.
+  // Fifth-order max-rE weights reduce sidelobes. No synthesized ambisonic LFE.
+  constexpr double pi=3.14159265358979323846;
+  const double angles[5]={0,30,110,250,330};
+  const int outputs[5]={2,0,3,4,1};
+  double weights[36]{};
+  double pn[6]={1,0.932469514203152};
+  for(int n=2;n<=5;n++)pn[n]=((2*n-1)*pn[1]*pn[n-1]-(n-1)*pn[n-2])/n;
+  for(int n=0;n<=5;n++)for(int k=n*n;k<(n+1)*(n+1);k++)weights[k]=(2*n+1)*pn[n];
+  constexpr int azSteps=720,elSteps=64;
+  for(int az=0;az<azSteps;az++) {
+   double deg=(az+.5)*360/azSteps;int a=0;while(a<4&&deg>=angles[a+1])a++;
+   int b=(a+1)%5;double end=b?angles[b]:360;
+   double gap=(end-angles[a])*pi/180,offset=(deg-angles[a])*pi/180;
+   double ga=std::sin(gap-offset)/std::sin(gap),gb=std::sin(offset)/std::sin(gap);
+   double norm=std::sqrt(ga*ga+gb*gb);ga/=norm;gb/=norm;
+   for(int el=0;el<elSteps;el++){
+    auto y=Basis(deg*pi/180,std::asin(-1+2*(el+.5)/elSteps));
+    for(int k=0;k<36;k++){
+     double v=y[k]*weights[k]/(azSteps*elSteps);
+     matrix[outputs[a]][k]+=ga*v;matrix[outputs[b]][k]+=gb*v;
+    }
+   }
+  }
+  auto front=Basis(0);double referenceEnergy=0;
+  for(int s=0;s<5;s++){double v=0;for(int k=0;k<36;k++)v+=matrix[s][k]*front[k];referenceEnergy+=v*v;}
+  // Kyty's original frontal stereo source produces L=R=1 (total energy 2).
+  // Match that reference rather than losing 3 dB by normalizing five feeds to 1.
+  double scale=std::sqrt(2/referenceEnergy);
+  for(auto& row:matrix)for(double& v:row)v*=scale;
+ }
+};
+
+// Output is FL FR C LFE SL SR. Return the active ambisonic coefficient mask.
+inline uint64_t Mix(const Decoder& decoder,const Port* ports,size_t count,const Port& bed,float* out) {
+ const unsigned channels=((bed.format>>8)&255)?std::min((bed.format>>8)&255,16u):2;
+ const int speakerMap[5]={0,1,2,4,5};
+ std::fill(out,out+size_t(bed.frames)*6,0.f);
+ for(unsigned f=0;f<bed.frames;f++) {
+  if(channels==2){out[f*6]=bed.pcm[f*2];out[f*6+1]=bed.pcm[f*2+1];}
+  else if(channels==8) {
+   for(int c=0;c<4;c++)out[f*6+c]=bed.pcm[f*8+c];
+   // Fold the 7.1 side+back pairs into the 5.1 surrounds at -3dB each.
+   out[f*6+4]=.70710678f*(bed.pcm[f*8+4]+bed.pcm[f*8+6]);
+   out[f*6+5]=.70710678f*(bed.pcm[f*8+5]+bed.pcm[f*8+7]);
+  }
+ }
+ uint64_t mask=0;
+ for(size_t i=0;i<count;i++) {
+  const Port& p=ports[i];
+  if(!p.used||p.context!=bed.context||(p.type&0xff00)!=0x100||!p.pcm||p.audioFormat!=4||p.frames!=bed.frames)continue;
+  if((p.ambisonics&0x40)!=0) {
+   const uint32_t acn=p.ambisonics&~0x40u;if(acn>=36)continue;
+   mask|=1ull<<acn;
+   for(int s=0;s<5;s++){
+    float gain=float(decoder.matrix[s][acn])*p.gain;
+    for(unsigned f=0;f<bed.frames;f++)out[f*6+speakerMap[s]]+=p.pcm[f]*gain;
+   }
+  } else {
+   // Unpositioned mono objects keep the original centered presentation.
+   for(unsigned f=0;f<bed.frames;f++)out[f*6+2]+=p.pcm[f]*p.gain;
+  }
+ }
+ return mask;
+}
+}
