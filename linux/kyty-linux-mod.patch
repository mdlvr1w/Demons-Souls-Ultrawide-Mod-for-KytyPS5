diff --git a/src/common/guardedCopy.cpp b/src/common/guardedCopy.cpp
index b625e88..5e1dd64 100644
--- a/src/common/guardedCopy.cpp
+++ b/src/common/guardedCopy.cpp
@@ -50,3 +50,24 @@ bool ResumeGuardedCopy(void* context) noexcept {
 } // namespace Common
 
 #endif
+
+#if defined(__linux__)
+#include <cerrno>
+#include <sys/uio.h>
+#include <unistd.h>
+
+namespace Common {
+// Read through the kernel so inaccessible guest pages return EFAULT rather than
+// entering the emulator's SIGSEGV handler. Return the number of bytes not copied.
+uint64_t GuardedCopy(void* destination, const void* source, uint64_t size) noexcept {
+    if (size == 0) return 0;
+    iovec local {destination, static_cast<size_t>(size)};
+    iovec remote {const_cast<void*>(source), static_cast<size_t>(size)};
+    ssize_t copied;
+    do {
+        copied = process_vm_readv(getpid(), &local, 1, &remote, 1, 0);
+    } while (copied < 0 && errno == EINTR);
+    return copied < 0 ? size : size - static_cast<uint64_t>(copied);
+}
+} // namespace Common
+#endif
