+static bool enabled() { return std::getenv("CODEX_CUSTOM_MODS") != nullptr; }
+static int key(const char* env, int fallback) {
+    const char* value = std::getenv(env);
+    const auto code = value ? SDL_GetKeyFromName(value) : SDLK_UNKNOWN;
+    return code == SDLK_UNKNOWN ? fallback : code;
+}
+static void persistStep(int step) {
+    static std::atomic<int> previous {-1};
+    if (previous.exchange(step) == step) return;
+    if (FILE* f = std::fopen("camera-step.txt", "w")) { std::fprintf(f, "%d\n", step); std::fclose(f); }
+}
+static void applyCamera(int step) {
+    if (!camera_slot) return;
+    float current = 0;
+    if (Common::GuardedCopy(&current, reinterpret_cast<void*>(camera_slot.load()), 4) != 0) return;
+    bool recognized = false;
+    for (int i = 0; i <= 4; ++i) recognized |= current == 4.5f + 1.125f * i;
+    if (!recognized) return;
+    const float target = 4.5f + 1.125f * step;
+    if (current == target) { camera_step = step; persistStep(step); return; }
+    const int fd = open("/proc/self/mem", O_RDWR | O_CLOEXEC);
+    if (fd < 0) return;
+    const bool ok = pwrite(fd, &target, 4, camera_slot.load()) == 4;
+    close(fd);
+    if (!ok) return;
+    camera_step = step;
+    persistStep(step);
+    std::printf("Custom camera: step %d, distance %.3f\n", step, target);
+}
+void InstallCamera(uint64_t base) {
+    if (!enabled()) return;
+    camera_slot = base + 0x27aaf50;
+    const char* value = std::getenv("CODEX_CAMERA_STEP");
+    camera_step = std::clamp(value ? std::atoi(value) : 0, 0, 4);
+    applyCamera(camera_step.load());
+    std::printf("Custom camera: watching guest slot %llx\n", (unsigned long long)camera_slot.load());
+}
+void CameraKey(int32_t code) {
+    if (!enabled()) return;
+    if (code == key("CODEX_CAMERA_FARTHER_KEY", SDLK_PAGEUP)) applyCamera(std::min(4, camera_step.load() + 1));
+    if (code == key("CODEX_CAMERA_CLOSER_KEY", SDLK_PAGEDOWN)) applyCamera(std::max(0, camera_step.load() - 1));
+}
+void TickCamera() {
+    static uint64_t last = 0;
+    const auto now = SDL_GetTicks64();
+    if (now - last < 250) return;
+    last = now;
+    if (auto* request = std::fopen("camera-request.txt", "r")) {
+        int step = -1;
+        const bool valid = std::fscanf(request, "%d", &step) == 1 && step >= 0 && step <= 4;
+        std::fclose(request); std::remove("camera-request.txt");
+        if (valid) camera_step = step;
+    }
+    applyCamera(camera_step.load());
+}
+} // namespace CustomMods
+
+extern "C" void* __real_memcpy(void*, const void*, size_t);
+void CustomMods::FixPreview(void* destination, size_t size) {
+    // Same copy shape and four source signatures as the Windows adapter.
+    // Only the known inventory record is touched, after the original copy.
+    bool match = false;
+    if (size == 0xc70 && reinterpret_cast<uintptr_t>(destination) >= 0x200000000ull &&
+        reinterpret_cast<uintptr_t>(destination) < 0x210000000ull) {
+        static const bool enabled = std::getenv("CODEX_UI_OUTPUT_WIDTH") != nullptr;
+        if (enabled) {
+            uint32_t values[4] {};
+            const auto* src = static_cast<const unsigned char*>(destination);
+            __real_memcpy(&values[0], src + 0xcc, 4); __real_memcpy(&values[1], src + 0xd4, 4);
+            __real_memcpy(&values[2], src + 0x14c, 4); __real_memcpy(&values[3], src + 0x154, 4);
+            match = values[0] == 0x3f9d6f3d && values[1] == 0x40227935 &&
+                    values[2] == 0x3f9d6f3d && values[3] == 0x40227935;
+        }
+    }
+    if (match) {
+        // Preserve the original adapter's calibrated 3440x1440 correction;
+        // interpolate its offset by the extra horizontal field of view.
+        const float width = std::strtof(std::getenv("CODEX_UI_OUTPUT_WIDTH"), nullptr);
+        const float delta = (width - 3840.f) / (5160.f - 3840.f);
+        float original, shifted;
+        const uint32_t a = 0x3f9d6f3d, b = 0x3f6e11ad;
+        __real_memcpy(&original, &a, 4); __real_memcpy(&shifted, &b, 4);
+        const float target = original + (shifted - original) * delta;
+        auto* dst = static_cast<unsigned char*>(destination);
+        __real_memcpy(dst + 0xcc, &target, 4); __real_memcpy(dst + 0x14c, &target, 4);
+        static std::atomic<unsigned> count {0};
+        if (count.fetch_add(1) == 0) std::printf("Custom inventory: preview camera corrected\n");
+    }
+}
+
+extern "C" void* __wrap_memcpy(void* destination, const void* source, size_t size) {
+    auto* result = __real_memcpy(destination, source, size);
+    CustomMods::FixPreview(destination, size);
+    return result;
+}
